{
	"name": "crypto-storage-lite",
	"version": "0.1.1",
	"license": "MIT",
	"author": "OneWafer",
	"type": "module",
	"description": "A tiny, synchronous browser storage wrapper with AES-GCM encryption for localStorage and sessionStorage.",
	"keywords": [
		"storage",
		"local storage",
		"session storage",
		"localStorage",
		"sessionStorage",
		"crypto",
		"encryption",
		"aes-gcm",
		"synchronous"
	],
	"files": [
		"dist",
		"types",
		"THIRD-PARTY-NOTICES.md"
	],
	"main": "./dist/storage.cjs",
	"module": "./dist/storage.js",
	"types": "./types/index.d.ts",
	"unpkg": "./dist/storage.umd.cjs",
	"jsdelivr": "./dist/storage.umd.cjs",
	"sideEffects": false,
	"homepage": "https://github.com/OneWafer/crypto-storage-lite#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/OneWafer/crypto-storage-lite.git"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/storage.js",
			"require": "./dist/storage.cjs",
			"default": "./dist/storage.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.build.json && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@noble/ciphers": "^2.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^20.19.0 || >=22.12.0",
			"onFail": "warn"
		}
	}
}
